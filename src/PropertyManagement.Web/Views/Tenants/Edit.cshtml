@model TenantInput
@{ ViewData["Title"] = Model.Id == 0 ? "Add tenant" : "Edit tenant"; }
<div class="page-heading"><div><a class="back-link" asp-action="Index"><i data-lucide="arrow-left" aria-hidden="true"></i>Tenants</a><h1>@ViewData["Title"]</h1></div></div>
<form method="post" asp-action="Edit" class="editor-form"><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><div asp-validation-summary="All" class="validation" role="alert"></div><h2>Contact details</h2><div class="form-grid"><div class="field full"><label asp-for="FullName"></label><input asp-for="FullName" required maxlength="120" autocomplete="name" /><span asp-validation-for="FullName"></span></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" type="email" required maxlength="200" autocomplete="email" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Phone"></label><input asp-for="Phone" type="tel" required maxlength="40" autocomplete="tel" /><span asp-validation-for="Phone"></span></div></div><div class="form-actions"><button class="button primary"><i data-lucide="check" aria-hidden="true"></i>Save tenant</button><a class="button secondary" asp-action="Index">Cancel</a></div></form>