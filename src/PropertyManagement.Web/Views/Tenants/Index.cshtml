@model IReadOnlyList<Tenant>
@{ ViewData["Title"] = "Tenants"; var today = DateOnly.FromDateTime(DateTime.Today); }
<div class="page-heading"><div><div class="eyebrow">PEOPLE</div><h1>Tenants <span class="heading-count">@Model.Count</span></h1></div><a class="button primary" asp-action="Create"><i data-lucide="plus" aria-hidden="true"></i>Add tenant</a></div>
<form class="filter-bar" method="get"><div class="search-field"><i data-lucide="search" aria-hidden="true"></i><label class="sr-only" for="search">Search tenants</label><input id="search" name="search" value="@ViewData["Search"]" placeholder="Search names or email addresses" maxlength="100" /></div><button class="button secondary"><i data-lucide="search" aria-hidden="true"></i>Search</button><a class="icon-button" asp-action="Index" title="Clear search" aria-label="Clear search"><i data-lucide="rotate-ccw" aria-hidden="true"></i></a></form>
@if (Model.Count == 0) { <div class="empty-state"><i data-lucide="users" aria-hidden="true"></i><h2>No tenants found</h2><a class="button primary" asp-action="Create">Add tenant</a></div> }
else { <div class="table-scroll"><table><thead><tr><th>Tenant</th><th>Contact</th><th>Current property</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody>
@foreach (var tenant in Model) {
    var current = tenant.Leases.Where(lease => lease.StartDate <= today && lease.EndDate >= today).Select(lease => lease.Property.Name).ToList();
    <tr><td><div class="entity"><span class="avatar">@tenant.FullName[..1].ToUpperInvariant()</span><a class="entity-name" asp-action="Edit" asp-route-id="@tenant.Id">@tenant.FullName</a></div></td><td><a href="mailto:@tenant.Email">@tenant.Email</a><small>@tenant.Phone</small></td><td>@(current.Count == 0 ? "No active lease" : string.Join(", ", current))</td><td><div class="row-actions"><a class="icon-button" asp-action="Edit" asp-route-id="@tenant.Id" title="Edit tenant" aria-label="Edit @tenant.FullName"><i data-lucide="pencil" aria-hidden="true"></i></a><form method="post" asp-action="Delete" asp-route-id="@tenant.Id" data-confirm="Remove this tenant? Linked lease history will prevent removal."><input type="hidden" name="version" value="@Convert.ToBase64String(tenant.Version)" /><button class="icon-button danger" title="Delete tenant" aria-label="Delete @tenant.FullName"><i data-lucide="trash-2" aria-hidden="true"></i></button></form></div></td></tr>
}
</tbody></table></div> }