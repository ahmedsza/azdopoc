@model IReadOnlyList<Lease>
@{ ViewData["Title"] = "Leases"; var today = DateOnly.FromDateTime(DateTime.Today); }
<div class="page-heading"><div><div class="eyebrow">AGREEMENTS</div><h1>Leases <span class="heading-count">@Model.Count</span></h1></div><a class="button primary" asp-action="Create"><i data-lucide="plus" aria-hidden="true"></i>New lease</a></div>
<div class="tabs" aria-label="Lease status">@foreach (var item in new[] { ("", "All leases"), ("active", "Active"), ("upcoming", "Upcoming"), ("ended", "Ended") }) { <a class="@(string.Equals(ViewData["Status"] as string ?? "", item.Item1) ? "selected" : "")" asp-action="Index" asp-route-status="@item.Item1">@item.Item2</a> }</div>
@if (Model.Count == 0) { <div class="empty-state"><i data-lucide="file-text" aria-hidden="true"></i><h2>No leases found</h2><a class="button primary" asp-action="Create">New lease</a></div> }
else { <div class="table-scroll"><table><thead><tr><th>Property / tenant</th><th>Lease period</th><th>Status</th><th class="number">Agreed rent / month</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody>
@foreach (var lease in Model) {
    var status = lease.StartDate > today ? "Upcoming" : lease.EndDate < today ? "Ended" : "Active";
    <tr><td><a class="entity-name" asp-action="Edit" asp-route-id="@lease.Id">@lease.Property.Name</a><small>@lease.Tenant.FullName</small></td><td>@lease.StartDate.ToString("dd MMM yyyy")<small>to @lease.EndDate.ToString("dd MMM yyyy")</small></td><td><span class="badge @(status == "Active" ? "good" : "neutral")">@status</span></td><td class="number">@lease.MonthlyRent.ToString("C2")</td><td><div class="row-actions"><a class="icon-button" asp-controller="Rent" asp-action="Record" asp-route-leaseId="@lease.Id" title="Record payment" aria-label="Record payment for @lease.Property.Name"><i data-lucide="wallet" aria-hidden="true"></i></a><a class="icon-button" asp-action="Edit" asp-route-id="@lease.Id" title="Edit lease" aria-label="Edit lease for @lease.Property.Name"><i data-lucide="pencil" aria-hidden="true"></i></a><form method="post" asp-action="Delete" asp-route-id="@lease.Id" data-confirm="Remove this lease? Recorded payments will prevent removal."><input type="hidden" name="version" value="@Convert.ToBase64String(lease.Version)" /><button class="icon-button danger" title="Delete lease" aria-label="Delete lease for @lease.Property.Name"><i data-lucide="trash-2" aria-hidden="true"></i></button></form></div></td></tr>
}
</tbody></table></div> }