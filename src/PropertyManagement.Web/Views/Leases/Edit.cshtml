@model LeaseInput
@{ ViewData["Title"] = Model.Id == 0 ? "New lease" : "Edit lease"; }
<div class="page-heading"><div><a class="back-link" asp-action="Index"><i data-lucide="arrow-left" aria-hidden="true"></i>Leases</a><h1>@ViewData["Title"]</h1></div></div>
<form method="post" asp-action="Edit" class="editor-form"><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><div asp-validation-summary="All" class="validation" role="alert"></div><h2>Agreement details</h2><div class="form-grid"><div class="field"><label asp-for="PropertyId"></label><select asp-for="PropertyId" asp-items="ViewBag.Properties" required><option value="">Select property</option></select><span asp-validation-for="PropertyId"></span></div><div class="field"><label asp-for="TenantId"></label><select asp-for="TenantId" asp-items="ViewBag.Tenants" required><option value="">Select tenant</option></select><span asp-validation-for="TenantId"></span></div><div class="field"><label asp-for="StartDate"></label><input asp-for="StartDate" type="date" min="1900-01-01" max="2100-12-31" required /><span asp-validation-for="StartDate"></span></div><div class="field"><label asp-for="EndDate"></label><input asp-for="EndDate" type="date" min="1900-01-01" max="2100-12-31" required /><span asp-validation-for="EndDate"></span></div><div class="field"><label asp-for="MonthlyRent"></label><input asp-for="MonthlyRent" type="number" min="0.01" max="999999999.99" step="0.01" required /><span asp-validation-for="MonthlyRent"></span></div></div><div class="form-actions"><button class="button primary"><i data-lucide="check" aria-hidden="true"></i>Save lease</button><a class="button secondary" asp-action="Index">Cancel</a></div></form>