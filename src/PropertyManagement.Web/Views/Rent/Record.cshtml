@model PaymentInput
@{ ViewData["Title"] = "Record payment"; }
<div class="page-heading"><div><a class="back-link" asp-action="Index" asp-route-month="@Model.RentalMonth?.ToString("yyyy-MM")"><i data-lucide="arrow-left" aria-hidden="true"></i>Rent ledger</a><h1>Record payment</h1></div></div>
<form method="post" asp-action="Record" class="editor-form"><input asp-for="SubmissionKey" type="hidden" /><div asp-validation-summary="All" class="validation" role="alert"></div><h2>Payment details</h2><div class="form-grid"><div class="field full"><label asp-for="LeaseId"></label><select asp-for="LeaseId" asp-items="ViewBag.Leases" required><option value="">Select lease</option></select><span asp-validation-for="LeaseId"></span></div><div class="field"><label asp-for="RentalMonth"></label><input asp-for="RentalMonth" type="month" asp-format="{0:yyyy-MM}" required /><span asp-validation-for="RentalMonth"></span></div><div class="field"><label asp-for="PaidOn"></label><input asp-for="PaidOn" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" required /><span asp-validation-for="PaidOn"></span></div><div class="field"><label asp-for="Amount"></label><input asp-for="Amount" type="number" min="0.01" max="999999999.99" step="0.01" required /><span asp-validation-for="Amount"></span></div><div class="field"><label asp-for="Reference"></label><input asp-for="Reference" maxlength="100" required /><span asp-validation-for="Reference"></span></div></div><div class="form-actions"><button class="button primary"><i data-lucide="check" aria-hidden="true"></i>Record payment</button><a class="button secondary" asp-action="Index" asp-route-month="@Model.RentalMonth?.ToString("yyyy-MM")">Cancel</a></div></form>