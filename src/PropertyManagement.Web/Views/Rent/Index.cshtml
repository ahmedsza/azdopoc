@model RentLedgerViewModel
@{ ViewData["Title"] = "Rent ledger"; }
<div class="page-heading"><div><div class="eyebrow">COLLECTIONS</div><h1>Rent ledger</h1></div><a class="button primary" asp-action="Record" asp-route-month="@Model.Month.ToString("yyyy-MM")"><i data-lucide="plus" aria-hidden="true"></i>Record payment</a></div>
<div class="section-heading"><h2>@Model.Month.ToString("MMMM yyyy")</h2><form method="get" class="month-filter"><label class="sr-only" for="month">Rental month</label><input id="month" name="month" type="month" value="@Model.Month.ToString("yyyy-MM")" required /><button class="icon-button" title="Apply month" aria-label="Apply month"><i data-lucide="arrow-right" aria-hidden="true"></i></button></form></div>
<section class="metrics three" aria-label="Rent totals"><div class="metric"><span class="metric-label">Expected rent</span><strong>@Model.Rows.Sum(row => row.MonthlyRent).ToString("C0")</strong><small>@Model.Rows.Count leases this month</small></div><div class="metric"><span class="metric-label">Collected</span><strong>@Model.Rows.Sum(row => row.Paid).ToString("C0")</strong><small>Allocated to @Model.Month.ToString("MMMM")</small></div><div class="metric"><span class="metric-label">Outstanding</span><strong>@Model.Rows.Sum(row => row.Outstanding).ToString("C0")</strong><small>@Model.Rows.Count(row => row.Outstanding > 0) leases with a balance</small></div></section>
@if (Model.Rows.Count == 0) { <div class="empty-state"><i data-lucide="wallet" aria-hidden="true"></i><h2>No leases for this month</h2><a class="button primary" asp-controller="Leases" asp-action="Create">New lease</a></div> }
else { <div class="table-scroll"><table><thead><tr><th>Property / tenant</th><th class="number">Expected</th><th class="number">Paid</th><th class="number">Outstanding</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody>
@foreach (var row in Model.Rows) { <tr><td><strong>@row.PropertyName</strong><small>@row.TenantName</small></td><td class="number">@row.MonthlyRent.ToString("C2")</td><td class="number">@row.Paid.ToString("C2")</td><td class="number">@row.Outstanding.ToString("C2")</td><td><span class="badge @(row.Outstanding == 0 ? "good" : "attention")">@row.Status</span></td><td><a class="icon-button" asp-action="Record" asp-route-leaseId="@row.LeaseId" asp-route-month="@Model.Month.ToString("yyyy-MM")" title="Record payment" aria-label="Record payment for @row.PropertyName"><i data-lucide="plus" aria-hidden="true"></i></a></td></tr> }
</tbody></table></div> }