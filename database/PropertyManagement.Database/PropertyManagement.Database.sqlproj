<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.2.0" />
  <PropertyGroup>
    <Name>PropertyManagement.Database</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql150DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <CompatibilityMode>150</CompatibilityMode>
    <RunSqlCodeAnalysis>true</RunSqlCodeAnalysis>
    <TreatTSqlWarningsAsErrors>true</TreatTSqlWarningsAsErrors>
    <SkipCheckForNewSDKVersion>true</SkipCheckForNewSDKVersion>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="Seed\**\*.sql" />
    <None Include="Seed\**\*.sql" />
  </ItemGroup>
</Project>